# Copy to .env and adjust for the host. docker compose reads .env automatically for the
# ${...} substitutions in compose.yaml / compose.prod.yaml. Every value below also has a
# default in those files, so the service runs even with no .env present — except the
# databases, which must exist on the host.

# Image tag to build and run. Keep it in step with `version` in pyproject.toml, and bump
# it per release rather than moving an existing tag.
IMAGE_NAME=churchilllab/foundervariants:0.2.0

# Target runtime platform. Most Linux servers are linux/amd64; build for that even when
# your development machine is Apple Silicon (linux/arm64).
PLATFORM=linux/amd64

# Host port published to the reverse proxy. Apache proxies the base path to
# localhost:HOST_PORT. Pick one that is free on the host — check with
# `ss -lntp | grep <port>` before deploying. (On churchilllab: ensimpl2=28222,
# ensimpl3=28223, FounderVariants=28224.)
HOST_PORT=28224

# Host directory of built fv.*.snps.sqlite files; mounted read-only into the container.
# On a server this is an absolute path to wherever the databases were copied, e.g.
# /srv/foundervariants/dbs. Budget ~4.3 GB per release.
HOST_DB_DIR=./dbs

# Mount point inside the container (the app reads FV_DB_DIR to find databases).
FV_DB_DIR=/data/dbs

# URL prefix the service is served under when behind a path-stripping reverse proxy.
# Apache strips this prefix before forwarding, so the app runs at root but still needs it
# to generate correct docs/static URLs. Leave empty when served at the domain root.
# Must match the <Location> in the Apache config (see apache-foundervariants.conf).
FV_BASE_PATH=/foundervariants

# Comma-separated allowed CORS origins for browser clients. Empty = allow all. The API is
# read-only and only GET is allowed, so open CORS is the default.
FV_CORS_ORIGINS=

# Log level: DEBUG, INFO, WARNING, ERROR. Database discovery ("loaded release 2021 from
# ...") logs at INFO, and a database that cannot be opened is reported at WARNING. DEBUG
# is what to use when /health reports fewer releases than you expect.
FV_LOG_LEVEL=INFO
